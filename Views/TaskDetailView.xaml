<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TP_M2I_DOTNET.Views.TaskDetailView"
             Title="TaskDetailView">
    <VerticalStackLayout Padding="20">
        <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold"/>
        <Label Text="{Binding Description}" FontSize="18"/>
        <Label Text="{Binding DueDate, StringFormat='À rendre le : {0:dd/MM/yyyy}'}"/>
        <Label Text="{Binding Priority, StringFormat='Priorité : {0}'}"/>
        <Label Text="{Binding Status, StringFormat='Statut : {0}'}"/>
    </VerticalStackLayout>
</ContentPage>